# ==========================================
# DevCraft / Horizon Server Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Runtime Environment (development | production)
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/devcraft?retryWrites=true&w=majority

# Secret for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# Optional frontend client URL for CORS allowed origins
CLIENT_URL=http://localhost:5173

# MongoDB AI Model APIs (Atlas Embedding & Reranking Gateway)
MONGODB_MODEL_API_KEY=your_mongodb_model_api_key_here
MONGODB_AI_ENDPOINT=https://ai.mongodb.com/v1

# Supabase Cloud Database & Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
